    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\TNC.Trading.Platform.AppHost\TNC.Trading.Platform.AppHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\src\TNC.Trading.Platform.AppHost\Realms\**\*">
