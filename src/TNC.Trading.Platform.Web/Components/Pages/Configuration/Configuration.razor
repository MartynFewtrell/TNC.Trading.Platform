@namespace TNC.Trading.Platform.Web.Components.Pages
@page "/configuration"
@attribute [Authorize(Policy = PlatformAuthenticationDefaults.Policies.Operator)]
@inject ConfigurationPagePresenter Presenter
@inject PlatformNavigationAccessCoordinator NavigationAccessCoordinator
@inject PlatformApiClient PlatformApiClient
@inject PlatformShellContextProvider ShellContextProvider

<PageTitle>Platform configuration</PageTitle>

@if (!hasRequiredScope)
{
    <section class="panel platform-callout">
        <h1>Platform configuration</h1>
        <p>Redirecting...</p>
    </section>
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <section class="panel platform-callout">
        <h1>Platform configuration</h1>
        <p class="error">@loadError</p>
    </section>
}
else if (form is null)
{
    <section class="panel platform-callout">
        <h1>Platform configuration</h1>
        <p>Loading platform configuration...</p>
    </section>
}
else
{
    <EditForm Model="form" OnValidSubmit="SaveAsync">
        <section class="panel platform-page-header">
            <div>
                <h1>Platform configuration</h1>
                <p class="hint">Update the protected operator configuration without exposing stored secrets.</p>
            </div>
        </section>

        <PlatformAccordionSection Title="Environment" IsOpen="true">
            <section class="panel">
                <p class="hint">Platform environment is deployment-owned and cannot be changed here. Broker selection is applied after restart.</p>
                @if (brokerStatus is not null)
                {
                    <p data-testid="configuration-applied-broker">Applied broker: @(brokerStatus.Applied?.Name ?? "None")</p>
                    <p data-testid="configuration-selected-broker">Selected broker: @(brokerStatus.Selected?.Name ?? "None")</p>
                    @if (brokerStatus.RestartRequired)
                    {
                        <p class="warning" role="status" data-testid="configuration-restart-required-indicator">Pending broker selection will apply on the next platform start.</p>
                    }
                    <div class="platform-option-list" role="radiogroup" aria-label="Broker environment">
                        @foreach (var broker in brokerEnvironments.Where(broker => !IsRetired(broker)))
                        {
                            <label class="platform-option-list__option">
                                <input type="radio" name="broker-selection" checked="@(selectedBrokerId == broker.Id)" @onchange="() => selectedBrokerId = broker.Id" disabled="@(!CanSelect(broker))" />
                                <span>
                                    @broker.Name (@broker.Kind)
                                    @if (!string.IsNullOrWhiteSpace(broker.AvailabilityReason))
                                    {
                                        <span class="hint platform-option-list__hint">@broker.AvailabilityReason</span>
                                    }
                                </span>
                            </label>
                        }
                    </div>
                    <label class="platform-option-list__acknowledgement">
                        <input type="checkbox" @bind="selectionAcknowledged" />
                        <span>I understand this selection takes effect after restart.</span>
                    </label>
                    <button class="platform-primary-action platform-primary-action--broker-selection" type="button" data-testid="configuration-select-broker-button" disabled="@(selectionInProgress || selectedBrokerId is null || !selectionAcknowledged)" @onclick="SelectBrokerAsync">@(selectionInProgress ? "Selecting..." : "Select broker")</button>
                    @if (!string.IsNullOrWhiteSpace(selectionMessage))
                    {
                        <p role="status" data-testid="configuration-selection-message">@selectionMessage</p>
                    }
                }
            </section>
        </PlatformAccordionSection>

        <PlatformAccordionSection Title="Trading schedule" IsOpen="false">
            <section class="panel">
                <div class="platform-form-grid">
                    <label>
                        Start of day
                        <InputText @bind-Value="form.StartOfDayText" type="time" />
                    </label>
                    <label>
                        End of day
                        <InputText @bind-Value="form.EndOfDayText" type="time" />
                    </label>
                    <label>
                        Trading days (comma separated)
                        <InputText @bind-Value="form.TradingDaysCsv" />
                    </label>
                    <label>
                        Weekend behavior
                        <InputSelect @bind-Value="form.TradingSchedule.WeekendBehavior">
                            <option value="ExcludeWeekends">ExcludeWeekends</option>
                            <option value="IncludeSaturday">IncludeSaturday</option>
                            <option value="IncludeSunday">IncludeSunday</option>
                            <option value="IncludeFullWeekend">IncludeFullWeekend</option>
                        </InputSelect>
                    </label>
                    <label>
                        Bank holidays (comma separated yyyy-MM-dd)
                        <InputText @bind-Value="form.BankHolidayCsv" />
                    </label>
                    <label>
                        Time zone
                        <InputText @bind-Value="form.TradingSchedule.TimeZone" />
                    </label>
                </div>
            </section>
        </PlatformAccordionSection>

        <PlatformAccordionSection Title="Retry policy" IsOpen="false">
            <section class="panel">
                <div class="platform-form-grid">
                    <label>
                        Initial delay seconds
                        <InputNumber @bind-Value="form.RetryPolicy.InitialDelaySeconds" />
                    </label>
                    <label>
                        Max automatic retries
                        <InputNumber @bind-Value="form.RetryPolicy.MaxAutomaticRetries" />
                    </label>
                    <label>
                        Multiplier
                        <InputNumber @bind-Value="form.RetryPolicy.Multiplier" />
                    </label>
                    <label>
                        Max delay seconds
                        <InputNumber @bind-Value="form.RetryPolicy.MaxDelaySeconds" />
                    </label>
                    <label>
                        Periodic delay minutes
                        <InputNumber @bind-Value="form.RetryPolicy.PeriodicDelayMinutes" />
                    </label>
                </div>
            </section>
        </PlatformAccordionSection>

        <PlatformAccordionSection Title="Notifications" IsOpen="false">
            <section class="panel">
                <div class="platform-form-grid">
                    <label>
                        Provider
                        <InputText @bind-Value="form.NotificationSettings.Provider" />
                    </label>
                    <label>
                        Email recipient
                        <InputText @bind-Value="form.NotificationSettings.EmailTo" />
                    </label>
                </div>
            </section>
        </PlatformAccordionSection>

        <PlatformAccordionSection Title="IG credentials" IsOpen="false">
            <section class="panel">
                <p class="hint" data-testid="configuration-secret-handling-hint">Stored values are never shown. Enter a field only when you want to replace it.</p>
                @if (form.Credentials.RequiresCredentialReentry)
                {
                    <p class="warning" role="status" data-testid="configuration-credential-reentry-message">Enter the IG Demo API key, identifier, and password together in one save to restore authentication.</p>
                }
                <div class="platform-credential-state">
                    <p data-testid="configuration-stored-api-key">Stored API key: @(form.Credentials.HasApiKey ? "Present" : "Missing")</p>
                    <p data-testid="configuration-stored-identifier">Stored identifier: @(form.Credentials.HasIdentifier ? "Present" : "Missing")</p>
                    <p data-testid="configuration-stored-password">Stored password: @(form.Credentials.HasPassword ? "Present" : "Missing")</p>
                </div>

                <div class="platform-form-grid">
                    <label>
                        New API key
                        <InputText @bind-Value="form.CredentialsUpdate.ApiKey" data-testid="configuration-new-api-key" />
                    </label>
                    <label>
                        New identifier
                        <InputText @bind-Value="form.CredentialsUpdate.Identifier" data-testid="configuration-new-identifier" />
                    </label>
                    <label>
                        New password
                        <InputText @bind-Value="form.CredentialsUpdate.Password" type="password" data-testid="configuration-new-password" />
                    </label>
                    <label>
                        Changed by
                        <InputText @bind-Value="form.ChangedBy" />
                    </label>
                </div>
            </section>
        </PlatformAccordionSection>

        <button class="platform-primary-action" data-testid="configuration-save-button" type="submit" disabled="@saveInProgress">@(saveInProgress ? "Saving..." : "Save configuration")</button>
    </EditForm>

    @if (!string.IsNullOrWhiteSpace(saveMessage))
    {
        <p role="status" data-testid="configuration-save-message">@saveMessage</p>
    }
}

@code {
    private ConfigurationFormModel? form;
    private bool hasRequiredScope;
    private bool saveInProgress;
    private string? loadError;
    private string? saveMessage;
    private IReadOnlyList<BrokerEnvironmentViewModel> brokerEnvironments = [];
    private BrokerEnvironmentStatusViewModel? brokerStatus;
    private Guid? selectedBrokerId;
    private bool selectionAcknowledged;
    private bool selectionInProgress;
    private string? selectionMessage;

    protected override async Task OnInitializedAsync()
    {
        hasRequiredScope = await NavigationAccessCoordinator.EnsureRequiredScopesAsync(
            "/configuration",
            PlatformAuthenticationDefaults.Scopes.Operator);
        if (!hasRequiredScope)
        {
            return;
        }

        await LoadAsync();
        await LoadBrokerSelectionAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Presenter.LoadAsync(CancellationToken.None);
        form = result.Form;
        loadError = result.ErrorMessage;
    }

    private async Task SaveAsync()
    {
        if (form is null)
        {
            return;
        }

        saveInProgress = true;
        saveMessage = null;

        try
        {
            var result = await Presenter.SaveAsync(form, CancellationToken.None);
            if (result.UpdatedForm is not null)
            {
                form = result.UpdatedForm;
            }

            saveMessage = result.Message;
        }
        finally
        {
            saveInProgress = false;
        }
    }

    private async Task LoadBrokerSelectionAsync()
    {
        try
        {
            brokerEnvironments = await PlatformApiClient.GetBrokerEnvironmentsAsync(CancellationToken.None);
            brokerStatus = await PlatformApiClient.GetBrokerEnvironmentStatusAsync(CancellationToken.None);
            selectedBrokerId = brokerStatus.Selected?.Id ?? brokerStatus.Applied?.Id;
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or PlatformScopeChallengeRequiredException)
        {
            selectionMessage = $"Unable to load broker selection: {exception.Message}";
        }
    }

    private bool CanSelect(BrokerEnvironmentViewModel broker) => string.Equals(broker.Availability, "Available", StringComparison.OrdinalIgnoreCase) && broker.CanAuthenticate;

    private static bool IsRetired(BrokerEnvironmentViewModel broker) =>
        string.Equals(broker.Lifecycle, "Retired", StringComparison.OrdinalIgnoreCase);

    private async Task SelectBrokerAsync()
    {
        if (brokerStatus is null || selectedBrokerId is not Guid brokerId || !selectionAcknowledged)
        {
            return;
        }

        selectionInProgress = true;
        selectionMessage = null;
        try
        {
            brokerStatus = await PlatformApiClient.SelectBrokerEnvironmentAsync(brokerId, brokerStatus.Revision, true, CancellationToken.None);
            selectionMessage = brokerStatus.RestartRequired ? "Broker selection saved. Restart the platform to apply it." : "Broker selection applied.";
            await ShellContextProvider.RefreshEnvironmentAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or PlatformScopeChallengeRequiredException)
        {
            selectionMessage = $"Broker selection failed: {exception.Message}";
        }
        finally
        {
            selectionInProgress = false;
        }
    }
}
