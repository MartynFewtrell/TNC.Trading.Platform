@namespace TNC.Trading.Platform.Web.Components.Pages
@page "/account-preferences"
@implements IDisposable
@attribute [Authorize(Policy = PlatformAuthenticationDefaults.Policies.Operator)]
@using TNC.Trading.Platform.Web.Authentication
@inject AccountPreferencesPagePresenter Presenter
@inject PlatformNavigationAccessCoordinator NavigationAccessCoordinator

<PageTitle>Account preferences</PageTitle>

@if (!hasRequiredScope) { <p data-testid="account-preferences-access">Redirecting...</p> }
else if (Presenter.IsLoading && Presenter.State.History.Count == 0) { <p data-testid="account-preferences-loading">Loading account preferences...</p> }
else
{
    <section class="panel platform-page-header"><div><h1>Trailing stops</h1></div></section>
    @if (!string.IsNullOrWhiteSpace(Presenter.CurrentError)) { <p class="error" role="alert" data-testid="account-preferences-error">@Presenter.CurrentError</p> }
    @if (!string.IsNullOrWhiteSpace(Presenter.State.FailureSummary))
    {
        <p class="error account-preferences-warning" role="alert" data-testid="account-preferences-warning" aria-live="assertive">@Presenter.State.FailureSummary</p>
    }
    <div class="account-preferences-tabs">
    <RadzenTabs @bind-SelectedIndex="selectedTabIndex" AriaLabel="Account preference views">
        <Tabs>
            <RadzenTabsItem Text="Settings">
                <section class="panel" aria-labelledby="account-preferences-state-heading">
                    <h2 id="account-preferences-state-heading">Trailing stops</h2>
                    <dl class="account-preferences-state">
                        <div><dt>Trailing stops</dt><dd>@(Presenter.State.DesiredTrailingStopsEnabled is bool desired ? (desired ? "Enabled" : "Disabled") : "Unconfigured")</dd></div>
                        @if (Presenter.State.LastVerifiedAtUtc is { } lastVerifiedAtUtc)
                        {
                            <div><dt>Last confirmed</dt><dd><time datetime="@lastVerifiedAtUtc.ToString("O")">@lastVerifiedAtUtc.ToLocalTime().ToString("g")</time></dd></div>
                        }
                    </dl>
                    @if (Presenter.State.VerificationStatus is "Pending") { <p role="status">Verification is pending.</p> }
                    <div class="account-preferences-actions" role="group" aria-label="Verification actions">
                        @if (Presenter.State.DesiredRevision is not null) { <button class="platform-primary-action" type="button" @onclick="CheckStatusAsync" disabled="@(Presenter.IsOperating || Presenter.IsSaving)">@(Presenter.IsOperating ? "Checking..." : "Check status")</button> }
                    </div>
                </section>
                @if (Presenter.State.HasConfirmedValue)
                {
                    <section class="panel">
                        <h2>Trailing stops configuration</h2>
                        <div class="account-preferences-control-row">
                            <fieldset class="account-preferences-choice" disabled="@Presenter.IsSaving">
                                <legend>Trailing stops</legend>
                                <InputRadioGroup TValue="bool" Value="@Presenter.State.TrailingStopsEnabled" ValueChanged="Presenter.Select" ValueExpression="@(() => Presenter.State.TrailingStopsEnabled)">
                                    <label><InputRadio Value="true" /> Enabled</label>
                                    <label><InputRadio Value="false" /> Disabled</label>
                                </InputRadioGroup>
                            </fieldset>
                            <div class="account-preferences-actions" role="group" aria-label="Preference actions">
                                <button @ref="saveButton" class="platform-primary-action" type="button" data-testid="account-preferences-save" @onclick="SaveAsync" disabled="@(Presenter.IsSaving || Presenter.IsOperating || Presenter.IsLoading)">@(Presenter.IsSaving ? "Saving..." : "Save preferences")</button>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Presenter.SaveError)) { <p class="error" role="alert">@Presenter.SaveError</p> }
                        @if (!string.IsNullOrWhiteSpace(Presenter.Message))
                        {
                            <div role="status" aria-atomic="true" data-testid="account-preferences-confirmation">
                                <span>@Presenter.Message</span>
                                <button type="button" @onclick="DismissConfirmationAsync">Dismiss save confirmation</button>
                            </div>
                        }
                    </section>
                }
            </RadzenTabsItem>
            <RadzenTabsItem Text="Observed history">
                <section class="panel" aria-labelledby="account-preferences-history-heading">
                    <h2 id="account-preferences-history-heading">Observed history</h2>
                    @if (!string.IsNullOrWhiteSpace(Presenter.HistoryError)) { <p class="error" role="alert" data-testid="account-preferences-history-error">@Presenter.HistoryError</p> }
                    <table><caption>Trailing stop observations, newest observed first</caption><thead><tr><th>Observed</th><th>Enabled</th><th>Kind</th><th>Environment</th></tr></thead><tbody>
                        @foreach (var observation in Presenter.State.History) { <tr @key="observation.Id"><td>@observation.ObservedAtUtc.ToLocalTime().ToString("g")</td><td>@observation.TrailingStopsEnabled</td><td>@observation.ObservationKind</td><td>@observation.PlatformEnvironment / @observation.BrokerEnvironment</td></tr> }
                    </tbody></table>
                    @if (!string.IsNullOrWhiteSpace(historyLoadMessage)) { <p role="status">@historyLoadMessage</p> }
                    <div class="account-preferences-actions" role="group" aria-label="History actions">
                        <button type="button" aria-label="Load older observations" data-testid="account-preferences-next" @onclick="LoadNextAsync" disabled="@(Presenter.IsLoading || Presenter.State.NextCursor is null)">Load older observations</button>
                    </div>
                </section>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
    </div>
}

@code {
    private bool hasRequiredScope;
    private int selectedTabIndex;
    private string? historyLoadMessage;
    private ElementReference saveButton;
    private readonly CancellationTokenSource requestLifetime = new();

    protected override async Task OnInitializedAsync()
    {
        hasRequiredScope = await NavigationAccessCoordinator.EnsureRequiredScopesAsync("/account-preferences", PlatformAuthenticationDefaults.Scopes.Operator);
        if (hasRequiredScope) await Presenter.LoadAsync(requestLifetime.Token);
    }
    private async Task SaveAsync() => await Presenter.SaveAsync(requestLifetime.Token);
    private async Task DismissConfirmationAsync()
    {
        Presenter.DismissConfirmation();
        await saveButton.FocusAsync();
    }
    private async Task LoadNextAsync()
    {
        await Presenter.LoadNextHistoryPageAsync(requestLifetime.Token);
        historyLoadMessage = "Older observations loaded.";
    }
    private async Task CheckStatusAsync() => await Presenter.CheckStatusAsync(requestLifetime.Token);
    public void Dispose()
    {
        requestLifetime.Cancel();
        requestLifetime.Dispose();
    }
}
