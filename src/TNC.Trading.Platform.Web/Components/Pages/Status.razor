@page "/status"
@attribute [Authorize(Policy = PlatformAuthenticationDefaults.Policies.Viewer)]
@using System.Text.Json
@inject PlatformApiClient PlatformApiClient
@inject PlatformNavigationAccessCoordinator NavigationAccessCoordinator
@inject PlatformOperatorContextAccessor OperatorContextAccessor

<PageTitle>Platform status</PageTitle>

@if (!hasRequiredScope)
{
    <section class="panel platform-callout">
        <h1>Platform status</h1>
        <p>Redirecting...</p>
    </section>
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <section class="panel platform-callout">
        <h1>Platform status</h1>
        <p class="error">@loadError</p>
    </section>
}
else if (status is null || events is null)
{
    <section class="panel platform-callout">
        <h1>Platform status</h1>
        <p>Loading platform status...</p>
    </section>
}
else
{
    <section class="panel platform-page-header">
        <div>
            <h1>Platform status</h1>
            <p class="hint">Review the current environment, supervision, and recent authentication activity.</p>
        </div>
    </section>

    <PlatformAccordionSection Title="Environment" IsOpen="true">
        <section class="panel" data-testid="status-environment-panel">
            <dl class="platform-key-value-grid">
                <dt>Platform environment</dt>
                <dd data-testid="platform-environment-value">@status.PlatformEnvironment</dd>
                <dt>Broker environment</dt>
                <dd data-testid="broker-environment-value">@status.BrokerEnvironment</dd>
                <dt>Live option availability</dt>
                <dd data-testid="live-option-availability-value">@(status.LiveOptionAvailable ? "Available" : "Visible but blocked")</dd>
                <dt>Last update</dt>
                <dd>@status.UpdatedAtUtc.ToLocalTime().ToString("g")</dd>
            </dl>
        </section>
    </PlatformAccordionSection>

    <PlatformAccordionSection Title="Trading schedule" IsOpen="false">
        <section class="panel" data-testid="status-trading-schedule-panel">
            <dl class="platform-key-value-grid">
                <dt>Schedule state</dt>
                <dd data-testid="trading-schedule-state-value">@(status.TradingScheduleState.IsActive ? "Active" : "Inactive")</dd>
                <dt>Reason</dt>
                <dd data-testid="trading-schedule-reason-value">@status.TradingScheduleState.Reason</dd>
                <dt>Daily window</dt>
                <dd>@status.TradingSchedule.StartOfDay - @status.TradingSchedule.EndOfDay (@status.TradingSchedule.TimeZone)</dd>
                <dt>Trading days</dt>
                <dd>@string.Join(", ", status.TradingSchedule.TradingDays)</dd>
                <dt>Weekend behavior</dt>
                <dd>@status.TradingSchedule.WeekendBehavior</dd>
                <dt>Bank holidays</dt>
                <dd>@(status.TradingSchedule.BankHolidayExclusions.Count == 0 ? "None configured" : string.Join(", ", status.TradingSchedule.BankHolidayExclusions))</dd>
            </dl>
        </section>
    </PlatformAccordionSection>

    <PlatformAccordionSection Title="Authentication supervision" IsOpen="false">
        <section class="panel" data-testid="status-auth-panel">
            <dl class="platform-key-value-grid">
                <dt>Session status</dt>
                <dd data-testid="auth-session-status-value">@status.AuthState.SessionStatus</dd>
                <dt>Degraded</dt>
                <dd data-testid="auth-degraded-value">@(status.AuthState.IsDegraded ? "Yes" : "No")</dd>
                <dt>Blocked reason</dt>
                <dd data-testid="auth-blocked-reason-value">@(status.AuthState.BlockedReason ?? "None")</dd>
                <dt>Retry phase</dt>
                <dd data-testid="auth-retry-phase-value">@status.RetryState.Phase</dd>
                <dt>Automatic attempt number</dt>
                <dd data-testid="auth-automatic-attempt-value">@status.RetryState.AutomaticAttemptNumber</dd>
                <dt>Next retry</dt>
                <dd data-testid="auth-next-retry-value">@(status.RetryState.NextRetryAtUtc?.ToString("u") ?? "Not scheduled")</dd>
            </dl>

            @if (status.AuthState.IsDegraded)
            {
                <p class="warning" role="alert" data-testid="auth-degraded-warning">Auth-dependent actions are blocked until the platform can restore an IG demo session.</p>
            }

            @if (operatorContext?.IsOperator == true)
            {
                <button class="platform-primary-action platform-manual-retry-button" data-testid="manual-retry-button" @onclick="TriggerManualRetryAsync" disabled="@(!status.RetryState.ManualRetryAvailable || manualRetryInProgress)">
                    @(manualRetryInProgress ? "Retrying..." : "Trigger manual retry")
                </button>
            }

            @if (!string.IsNullOrWhiteSpace(manualRetryMessage))
            {
                <p role="status" data-testid="manual-retry-message">@manualRetryMessage</p>
            }
        </section>
    </PlatformAccordionSection>

    <PlatformAccordionSection Title="IG login" IsOpen="false">
        <section class="panel" data-testid="status-ig-login-panel">
            <dl class="platform-key-value-grid">
                <dt>Current login state</dt>
                <dd data-testid="ig-current-state-value">@GetCurrentIgLoginState(status)</dd>
                <dt>Schedule context</dt>
                <dd data-testid="ig-schedule-context-value">@(status.IgLogin.ScheduleState.IsActive ? "In schedule" : "Out of schedule")</dd>
                <dt>Schedule reason</dt>
                <dd data-testid="ig-schedule-reason-value">@status.IgLogin.ScheduleState.Reason</dd>
                <dt>Retry context</dt>
                <dd data-testid="ig-retry-context-value">@GetRetryContext(status.IgLogin.RetryState)</dd>
                <dt>Last attempt</dt>
                <dd data-testid="ig-last-attempt-value">@(status.IgLogin.LastAttemptAtUtc?.ToLocalTime().ToString("g") ?? "None")</dd>
                <dt>Last successful login</dt>
                <dd data-testid="ig-last-success-value">@(status.IgLogin.LastSuccessfulLoginAtUtc?.ToLocalTime().ToString("g") ?? "None")</dd>
                <dt>Latest failure summary</dt>
                <dd data-testid="ig-latest-failure-value">@(status.IgLogin.LatestFailureSummary ?? "None")</dd>
            </dl>

            @if (status.IgLogin.LatestSnapshot is null)
            {
                <p data-testid="ig-latest-payload-empty">No successful IG login payload has been captured yet.</p>
            }
            else
            {
                <details data-testid="ig-latest-payload-details">
                    <summary>Latest successful IG login payload details</summary>
                    <dl class="platform-key-value-grid">
                        <dt>Captured at</dt>
                        <dd data-testid="ig-latest-payload-captured-at-value">@status.IgLogin.LatestSnapshot.CapturedAtUtc.ToLocalTime().ToString("g")</dd>
                        <dt>Trading day</dt>
                        <dd data-testid="ig-latest-payload-trading-day-value">@status.IgLogin.LatestSnapshot.TradingDay</dd>
                        <dt>Current account</dt>
                        <dd data-testid="ig-latest-payload-account-value">@status.IgLogin.LatestSnapshot.CurrentAccountId</dd>
                        <dt>Lightstreamer endpoint</dt>
                        <dd data-testid="ig-latest-payload-lightstreamer-value">@(status.IgLogin.LatestSnapshot.LightstreamerEndpoint ?? "None")</dd>
                        <dt>Session expiry</dt>
                        <dd data-testid="ig-latest-payload-expiry-value">@(status.IgLogin.LatestSnapshot.SessionExpiresAtUtc?.ToLocalTime().ToString("g") ?? "Not supplied")</dd>
                    </dl>

                    <h3>Response headers</h3>

                    @if (status.IgLogin.LatestSnapshot.ResponseHeaders.Count == 0)
                    {
                        <p data-testid="ig-latest-payload-headers-empty">No non-secret response headers were stored.</p>
                    }
                    else
                    {
                        <ul data-testid="ig-latest-payload-headers-list">
                            @foreach (var header in status.IgLogin.LatestSnapshot.ResponseHeaders.OrderBy(item => item.Key, StringComparer.OrdinalIgnoreCase))
                            {
                                <li><strong>@header.Key:</strong> @header.Value</li>
                            }
                        </ul>
                    }

                    <h3>Raw non-secret payload</h3>
                    <pre data-testid="ig-latest-payload-json">@FormatPayloadJson(status.IgLogin.LatestSnapshot.RawNonSecretPayloadJson)</pre>
                </details>
            }
        </section>
    </PlatformAccordionSection>

    <PlatformAccordionSection Title="IG Demo proof data" IsOpen="false">
        <section class="panel" data-testid="status-ig-proof-data-panel">
            @if (status.IgLogin.LatestProofData is null)
            {
                <p data-testid="ig-proof-data-empty">No IG Demo proof data has been retrieved yet.</p>
            }
            else
            {
                <dl class="platform-key-value-grid">
                    <dt>Preferred account</dt>
                    <dd data-testid="ig-proof-account-name">@(status.IgLogin.LatestProofData.PreferredAccountName ?? "Unknown")</dd>
                    <dt>Account ID</dt>
                    <dd data-testid="ig-proof-account-id">@(status.IgLogin.LatestProofData.PreferredAccountId ?? "Unknown")</dd>
                    <dt>Balance</dt>
                    <dd data-testid="ig-proof-balance">@(status.IgLogin.LatestProofData.Balance?.ToString("F2") ?? "Unavailable")</dd>
                    <dt>Open positions</dt>
                    <dd data-testid="ig-proof-position-count">@status.IgLogin.LatestProofData.OpenPositionCount</dd>
                    <dt>Retrieved at</dt>
                    <dd data-testid="ig-proof-retrieved-at">@status.IgLogin.LatestProofData.RetrievedAtUtc.ToLocalTime().ToString("g")</dd>
                </dl>
                <p class="hint" data-testid="ig-proof-data-source">Data sourced from IG Demo (read-only). No trades or orders have been placed.</p>
            }
        </section>
    </PlatformAccordionSection>

    <PlatformAccordionSection Title="Recent auth events" IsOpen="false">
        <section class="panel">
            @if (events.Events.Count == 0)
            {
                <p>No auth events recorded.</p>
            }
            else
            {
                <table>
                    <thead>
                        <tr>
                            <th>When</th>
                            <th>Type</th>
                            <th>Summary</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var platformEvent in events.Events.Take(10))
                    {
                        <tr>
                            <td>@platformEvent.OccurredAtUtc.ToString("u")</td>
                            <td>@platformEvent.EventType</td>
                            <td>@platformEvent.Summary</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </section>
    </PlatformAccordionSection>
}

@code {
    private PlatformStatusViewModel? status;
    private PlatformEventsViewModel? events;
    private PlatformOperatorContext? operatorContext;
    private bool hasRequiredScope;
    private bool manualRetryInProgress;
    private string? loadError;
    private string? manualRetryMessage;

    protected override async Task OnInitializedAsync()
    {
        operatorContext = await OperatorContextAccessor.GetCurrentAsync();
        hasRequiredScope = await NavigationAccessCoordinator.EnsureRequiredScopesAsync(
            "/status",
            PlatformAuthenticationDefaults.Scopes.Viewer);
        if (!hasRequiredScope)
        {
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loadError = null;

        try
        {
            status = await PlatformApiClient.GetStatusAsync(CancellationToken.None);
            events = await PlatformApiClient.GetAuthEventsAsync(status.BrokerEnvironment, CancellationToken.None);
        }
        catch (Exception exception) when (exception is HttpRequestException or PlatformScopeChallengeRequiredException or InvalidOperationException)
        {
            loadError = $"Unable to load platform status: {exception.Message}";
        }
    }

    private async Task TriggerManualRetryAsync()
    {
        manualRetryInProgress = true;
        manualRetryMessage = null;

        try
        {
            var retry = await PlatformApiClient.TriggerManualRetryAsync(CancellationToken.None);
            manualRetryMessage = $"Manual retry started with cycle id {retry.RetryCycleId}.";
        }
        catch (HttpRequestException exception)
        {
            manualRetryMessage = $"Manual retry could not be started: {exception.Message}";
        }
        finally
        {
            manualRetryInProgress = false;
            await LoadAsync();
        }
    }

    private static string GetCurrentIgLoginState(PlatformStatusViewModel currentStatus)
    {
        if (!currentStatus.IgLogin.ScheduleState.IsActive
            || string.Equals(currentStatus.IgLogin.CurrentState, "OutOfSchedule", StringComparison.OrdinalIgnoreCase))
        {
            return "Out of schedule";
        }

        if (string.Equals(currentStatus.IgLogin.CurrentState, "Active", StringComparison.OrdinalIgnoreCase))
        {
            return "Active";
        }

        if (!string.Equals(currentStatus.IgLogin.RetryState.Phase, "None", StringComparison.OrdinalIgnoreCase)
            || currentStatus.IgLogin.RetryState.NextRetryAtUtc is not null)
        {
            return "Retrying";
        }

        if (string.Equals(currentStatus.IgLogin.CurrentState, "Blocked", StringComparison.OrdinalIgnoreCase))
        {
            return "Blocked";
        }

        if (string.Equals(currentStatus.IgLogin.CurrentState, "Unknown", StringComparison.OrdinalIgnoreCase))
        {
            return "Not signed in";
        }

        if (currentStatus.AuthState.IsDegraded
            || string.Equals(currentStatus.IgLogin.CurrentState, "Degraded", StringComparison.OrdinalIgnoreCase))
        {
            return "Failed";
        }

        return currentStatus.IgLogin.CurrentState;
    }

    private static string GetRetryContext(RetryStateViewModel retryState)
    {
        if (string.Equals(retryState.Phase, "None", StringComparison.OrdinalIgnoreCase))
        {
            return "No retry scheduled";
        }

        var nextRetry = retryState.NextRetryAtUtc?.ToLocalTime().ToString("g") ?? "pending";
        return $"{retryState.Phase} (attempt {retryState.AutomaticAttemptNumber}, next retry {nextRetry})";
    }

    private static string FormatPayloadJson(string rawPayloadJson)
    {
        if (string.IsNullOrWhiteSpace(rawPayloadJson))
        {
            return "{}";
        }

        try
        {
            using var document = JsonDocument.Parse(rawPayloadJson);
            return JsonSerializer.Serialize(document.RootElement, new JsonSerializerOptions
            {
                WriteIndented = true
            });
        }
        catch (JsonException)
        {
            return rawPayloadJson;
        }
    }
}
