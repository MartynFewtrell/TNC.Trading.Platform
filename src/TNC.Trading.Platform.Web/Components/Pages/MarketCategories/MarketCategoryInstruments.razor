@namespace TNC.Trading.Platform.Web.Components.Pages
@page "/market-categories/{CategoryCode}/instruments"
@implements IDisposable
@attribute [Authorize(Policy = PlatformAuthenticationDefaults.Policies.Viewer)]
@using TNC.Trading.Platform.Web.Authentication
@inject MarketCategoryInstrumentsPagePresenter Presenter
@inject PlatformNavigationAccessCoordinator NavigationAccessCoordinator

<PageTitle>Saved instruments — @CategoryCode</PageTitle>

@if (!hasRequiredScope)
{
    <p data-testid="market-category-instruments-access">Redirecting...</p>
}
else if (Presenter.IsLoading && Presenter.Page is null)
{
    <section class="panel" data-testid="market-category-instruments-loading"><p>Loading saved instruments...</p></section>
}
else
{
    <section class="panel">
        <div class="platform-page-header">
            <h1>Saved instruments: @CategoryCode</h1>
            <a class="market-category-link" href="/market-categories">Back to market categories</a>
        </div>
        @if (Presenter.Category is { } category)
        {
            <p data-testid="instrument-category-interest">Interest: @(category.Interested ? "Interested" : "Not interested")</p>
            @if (category.NonTradeable)
            {
                <p class="hint">The provider marks this category as non-tradeable. This is provider metadata, not a trading-permission decision.</p>
            }
        }
        <div class="instrument-collection-summary">
            @if (Presenter.Category?.LastSuccessfulCollectionAtUtc is { } collectedAt)
            {
                <p>Last successful collection: <time datetime="@collectedAt.ToString("O")">@collectedAt.ToLocalTime().ToString("g")</time></p>
            }
            @if (Presenter.CollectionStatus?.NextWakeUpUtc is { } nextWakeUp)
            {
                <p>Next scheduled collection check: <time datetime="@nextWakeUp.ToString("O")">@nextWakeUp.ToLocalTime().ToString("g")</time></p>
            }
        </div>
        @if (Presenter.DetailCoverage is { } detailCoverage)
        {
            <div class="market-detail-category-coverage" data-testid="market-detail-category-coverage">
                <strong>Market details coverage:</strong> @detailCoverage.State
                @if (detailCoverage.ExpectedCount is { } expected
                    && detailCoverage.CompletedCount is { } completed)
                {
                    <span> (@completed of @expected expected complete</span>
                    @if (detailCoverage.ExcludedCount is { } excluded)
                    {
                        <span>, @excluded excluded</span>
                    }
                    <span>)</span>
                }
                @if (detailCoverage.LastCompleteAtUtc is { } lastCompleteAt)
                {
                    <span> — Last complete: <time datetime="@lastCompleteAt.ToUniversalTime().ToString("O")">@FormatUtc(lastCompleteAt)</time></span>
                }
                @if (!string.IsNullOrWhiteSpace(detailCoverage.SafeFailureCode))
                {
                    <p class="warning" role="status">@detailCoverage.SafeFailureCode</p>
                }
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(Presenter.MetadataError))
        {
            <p class="warning" role="status" data-testid="market-detail-category-coverage-unavailable">
                Market details coverage is unavailable; the saved instrument page remains available.
            </p>
        }
    </section>

    @if (Presenter.IsLoading)
    {
        <p role="status" data-testid="market-category-instruments-loading-more">Loading another saved page...</p>
    }
    @if (!string.IsNullOrWhiteSpace(Presenter.Error))
    {
        <p class="error" role="alert" data-testid="market-category-instruments-error">@Presenter.Error</p>
    }
    @if (!string.IsNullOrWhiteSpace(Presenter.MetadataError))
    {
        <p class="warning" role="status" data-testid="market-category-instruments-metadata-error">@Presenter.MetadataError</p>
    }

    @if (Presenter.Page is { State: "NeverCollected" })
    {
        <section class="panel" data-testid="market-category-instruments-never-collected">
            <h2>Not collected yet</h2>
            <p>No complete instrument snapshot has been saved for this category.</p>
        </section>
    }
    else if (Presenter.Page is { State: "Complete", Instruments.Count: 0, NextCursor: null })
    {
        <section class="panel" data-testid="market-category-instruments-complete-empty">
            <h2>Complete empty snapshot</h2>
            <p>The latest successful collection contained no instruments.</p>
        </section>
    }
    else if (Presenter.Page is { State: "Complete" } page)
    {
        <section class="panel" data-testid="market-category-instruments-saved">
            <h2>Saved snapshot</h2>
            @if (page.LastRetrievedAtUtc is { } retrievedAt)
            {
                <p>Retrieved <time datetime="@retrievedAt.ToString("O")">@retrievedAt.ToLocalTime().ToString("g")</time>.</p>
            }
            <p class="hint">Prices and market state are a saved provider snapshot; they may be delayed and are not a live quote or trading instruction.</p>
            <div class="instrument-tabs">
                <RadzenTabs @bind-SelectedIndex="selectedIndex" Change="OnTabChanged" AriaLabel="Saved instruments">
                    <Tabs>
                        @foreach (var instrument in page.Instruments)
                        {
                            <RadzenTabsItem @key="instrument.Epic" Text="@instrument.Name">
                                <article data-testid="market-category-instrument">
                                    <h3>@instrument.Name</h3>
                                    <div class="market-detail-availability" data-testid="market-detail-availability">
                                        <strong>Market details:</strong> @FormatDetailState(instrument.MarketDetails?.State)
                                        @if (instrument.MarketDetails?.DetailRetrievedAtUtc is { } detailRetrievedAt)
                                        {
                                            <span> — Retrieved: <time datetime="@detailRetrievedAt.ToString("O")">@FormatUtc(detailRetrievedAt)</time></span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(instrument.MarketDetails?.SafeFailureCode))
                                        {
                                            <span class="warning"> — @instrument.MarketDetails.SafeFailureCode</span>
                                        }
                                        <a class="market-category-link" href="@GetMarketDetailsHref(instrument.Epic)">View saved market details</a>
                                    </div>
                                    <RadzenRow>
                                        <RadzenColumn Size="12" SizeMD="6">
                                            <dl class="platform-key-value-grid">
                                                <dt>EPIC</dt><dd>@instrument.Epic</dd>
                                                <dt>Type</dt><dd>@instrument.InstrumentType</dd>
                                                <dt>Expiry</dt><dd>@instrument.Expiry</dd>
                                                <dt>Bid</dt><dd>@instrument.Bid</dd>
                                                <dt>Offer</dt><dd>@instrument.Offer</dd>
                                                <dt>Market status</dt><dd>@instrument.MarketStatus</dd>
                                                <dt>IG update time</dt><dd>@instrument.UpdateTime</dd>
                                            </dl>
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="6">
                                            <dl class="platform-key-value-grid">
                                                <dt>Underlying</dt><dd>@instrument.UnderlyingName</dd>
                                                <dt>Lot size</dt><dd>@instrument.LotSize</dd>
                                                <dt>OTC tradeable</dt><dd>@instrument.OtcTradeable</dd>
                                                <dt>Scaling factor</dt><dd>@instrument.ScalingFactor</dd>
                                                <dt>Expiry timestamp</dt><dd>@instrument.ExpiryTimestamp</dd>
                                                <dt>Delay time</dt><dd>@instrument.DelayTime</dd>
                                                <dt>High</dt><dd>@instrument.High</dd>
                                                <dt>Low</dt><dd>@instrument.Low</dd>
                                                <dt>Net change</dt><dd>@instrument.NetChange</dd>
                                                <dt>Percentage change</dt><dd>@instrument.PercentageChange</dd>
                                                <dt>Popularity</dt><dd>@instrument.Popularity</dd>
                                            </dl>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </article>
                            </RadzenTabsItem>
                        }
                    </Tabs>
                </RadzenTabs>
            </div>
            <nav class="instrument-pagination" aria-label="Saved instrument pages">
                <button class="platform-primary-action" type="button" @onclick="LoadPreviousAsync" disabled="@(!Presenter.CanGoPrevious || Presenter.IsLoading)">Previous page</button>
                <span>Page @Presenter.CurrentPageNumber of @Presenter.PageCountDescription</span>
                <button class="platform-primary-action" type="button" @onclick="LoadNextAsync" disabled="@(!Presenter.CanGoNext || Presenter.IsLoading)">Next page</button>
            </nav>
        </section>
    }
    @if (Presenter.IsStale)
    {
        <button class="platform-primary-action" type="button" data-testid="market-category-instruments-reload" @onclick="ReloadAsync">Reload current snapshot</button>
    }
}

@code {
    [Parameter]
    public string CategoryCode { get; set; } = string.Empty;

    private bool hasRequiredScope;
    private string? authorizedCategoryCode;
    private readonly CancellationTokenSource requestLifetime = new();

    protected override async Task OnParametersSetAsync()
    {
        if (!string.Equals(authorizedCategoryCode, CategoryCode, StringComparison.Ordinal))
        {
            hasRequiredScope = await NavigationAccessCoordinator.EnsureRequiredScopesAsync(
                $"/market-categories/{Uri.EscapeDataString(CategoryCode)}/instruments",
                PlatformAuthenticationDefaults.Scopes.Viewer);
            authorizedCategoryCode = CategoryCode;
        }

        if (hasRequiredScope)
        {
            await Presenter.LoadAsync(CategoryCode, requestLifetime.Token);
            ReconcileSelectedInstrument();
        }
    }

    private int selectedIndex;

    private void OnTabChanged(int index)
    {
        selectedIndex = index;
        var instruments = Presenter.Page?.Instruments;
        var selectedEpic = instruments is not null && index >= 0 && index < instruments.Count
            ? instruments[index].Epic : null;
        Presenter.SelectInstrument(selectedEpic);
    }

    private void ReconcileSelectedInstrument()
    {
        var instruments = Presenter.Page?.Instruments;
        selectedIndex = 0;
        if (instruments is not null)
        {
            for (var index = 0; index < instruments.Count; index++)
            {
                if (string.Equals(instruments[index].Epic, Presenter.SelectedEpic, StringComparison.Ordinal))
                {
                    selectedIndex = index;
                    break;
                }
            }
        }
        Presenter.SelectInstrument(instruments is { Count: > 0 } ? instruments[selectedIndex].Epic : null);
    }

    private async Task LoadPreviousAsync()
    {
        await Presenter.LoadPreviousAsync(CategoryCode, requestLifetime.Token);
        ReconcileSelectedInstrument();
    }

    private async Task LoadNextAsync()
    {
        await Presenter.LoadNextAsync(CategoryCode, requestLifetime.Token);
        ReconcileSelectedInstrument();
    }

    private async Task ReloadAsync()
    {
        await Presenter.ReloadAsync(CategoryCode, requestLifetime.Token);
        ReconcileSelectedInstrument();
    }

    private string GetMarketDetailsHref(string epic)
    {
        var path = $"/market-categories/{Uri.EscapeDataString(CategoryCode)}/instruments/{Uri.EscapeDataString(epic)}/market-details";
        return Presenter.Page?.SnapshotVersion is { } version
            ? $"{path}?listingVersion={version.ToString(System.Globalization.CultureInfo.InvariantCulture)}"
            : path;
    }

    private static string FormatDetailState(string? state) => state switch
    {
        "Complete" => "Complete",
        "OutOfDate" => "Out of date",
        "NotCollected" => "Not collected",
        "Excluded" => "Excluded",
        "NotFollowed" => "Not followed",
        null => "Availability unavailable",
        _ => state
    };

    private static string FormatUtc(DateTimeOffset value) =>
        value.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss 'UTC'", System.Globalization.CultureInfo.InvariantCulture);

    public void Dispose()
    {
        requestLifetime.Cancel();
        requestLifetime.Dispose();
    }
}
