@namespace TNC.Trading.Platform.Web.Components.Pages
@page "/market-categories"
@implements IDisposable
@attribute [Authorize(Policy = PlatformAuthenticationDefaults.Policies.Viewer)]
@using TNC.Trading.Platform.Web.Authentication
@inject MarketCategoriesPagePresenter Presenter
@inject PlatformNavigationAccessCoordinator NavigationAccessCoordinator
@inject PlatformOperatorContextAccessor OperatorContextAccessor

<PageTitle>Market categories</PageTitle>

@if (!hasRequiredScope)
{
    <p data-testid="market-categories-access">Redirecting...</p>
}
else if (Presenter.IsLoading && Presenter.State is null)
{
    <section class="panel" data-testid="market-categories-loading"><p>Loading market categories...</p></section>
}
else
{
    <section class="panel platform-page-header">
        <div><h1>Market categories</h1><p class="hint">Saved market categories from the configured IG environment.</p></div>
        @if (canRefresh)
        {
            <button class="platform-primary-action" type="button" data-testid="market-categories-refresh" @onclick="RefreshAsync" disabled="@(Presenter.IsRefreshing || Presenter.SavingInterestCategoryCode is not null)">
                @(Presenter.IsRefreshing ? "Refreshing..." : "Refresh")
            </button>
        }
    </section>

    @if (Presenter.State is null)
    {
        <section class="panel" data-testid="market-categories-failure" role="alert"><p>@Presenter.Error</p></section>
    }
    else if (!Presenter.State.HasSavedSnapshot)
    {
        <section class="panel" data-testid="market-categories-empty"><p>No saved market categories are available yet.</p></section>
    }
    else
    {
        <section class="panel" data-testid="market-categories-saved">
            <h2>Saved categories</h2>
            <p>Last refreshed <time datetime="@Presenter.State.LastRefreshedAtUtc!.Value.ToString("O")">@Presenter.State.LastRefreshedAtUtc.Value.ToLocalTime().ToString("g")</time></p>
            @if (Presenter.State.InterestRevision is { } interestRevision)
            {
                <p data-testid="market-category-interest-revision">Interest revision: @interestRevision</p>
            }
            <table>
                <caption>Saved market categories and instrument collection state</caption>
                <thead><tr><th scope="col">Category</th><th scope="col">Non-tradeable</th><th scope="col">Interest</th><th scope="col">Last collection</th><th scope="col">Collection result</th></tr></thead>
                <tbody>
                    @foreach (var (category, index) in Presenter.State.Categories.Select((item, index) => (item, index)))
                    {
                        var checkboxId = $"category-interest-{index}";
                        <tr @key="category.Code">
                            <td><a href="@($"/market-categories/{Uri.EscapeDataString(category.Code)}/instruments")">@category.Code instruments</a></td>
                            <td>@(category.NonTradeable ? "Non-tradeable (provider fact)" : "Tradeable")</td>
                            <td>
                                @if (canRefresh)
                                {
                                    <label for="@checkboxId">Interested in @category.Code</label>
                                    <input id="@checkboxId" type="checkbox" checked="@category.Interested"
                                           disabled="@(Presenter.SavingInterestCategoryCode is not null || Presenter.IsRefreshing)"
                                           @onchange="args => SetInterestAsync(category, args)" />
                                }
                                else
                                {
                                    <span>@(category.Interested ? "Interested" : "Not interested")</span>
                                }
                            </td>
                            <td>
                                @if (category.LastSuccessfulCollectionAtUtc is { } collectedAt)
                                {
                                    <time datetime="@collectedAt.ToString("O")">@collectedAt.ToLocalTime().ToString("g")</time>
                                }
                                else
                                {
                                    <span>Never collected</span>
                                }
                            </td>
                            <td>
                                @(category.CollectionOutcome ?? "No collection")
                                @if (!string.IsNullOrWhiteSpace(category.SafeFailure))
                                {
                                    <span class="warning"> — @category.SafeFailure</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }

    @if (Presenter.CollectionStatus is { } collectionStatus)
    {
        <section class="panel" aria-label="Instrument collection schedule" data-testid="market-category-collection-status">
            <h2>Instrument collection</h2>
            <p>Collector: @collectionStatus.State@(string.IsNullOrWhiteSpace(collectionStatus.PauseReason) ? string.Empty : $" — {collectionStatus.PauseReason}")</p>
            @if (collectionStatus.NextWakeUpUtc is { } nextWakeUp)
            {
                <p>Next scheduled check: <time datetime="@nextWakeUp.ToString("O")">@nextWakeUp.ToLocalTime().ToString("g")</time></p>
            }
            @if (collectionStatus.ApprovedDailyRequestAllowance is { } allowance)
            {
                <p>Daily request quota: @collectionStatus.UsedRequestBudget used of @allowance.</p>
            }
            else
            {
                <p>Daily request allowance is not configured; collection is paused.</p>
            }
        </section>
    }
    @if (!string.IsNullOrWhiteSpace(Presenter.CollectionStatusError))
    {
        <p class="error" role="status" data-testid="market-category-collection-status-error">@Presenter.CollectionStatusError</p>
    }
    @if (Presenter.State?.DormantInterests.Count > 0)
    {
        <section class="panel" data-testid="market-category-dormant-interests">
            <h2>Dormant interests</h2>
            <p>These saved interests are not in the current category catalogue and will not be collected.</p>
            <ul>
                @foreach (var dormantCode in Presenter.State.DormantInterests)
                {
                    <li>@dormantCode</li>
                }
            </ul>
        </section>
    }
    @if (!string.IsNullOrWhiteSpace(Presenter.InterestMessage))
    {
        <p role="status" data-testid="market-category-interest-message">@Presenter.InterestMessage</p>
    }
    @if (!string.IsNullOrWhiteSpace(Presenter.InterestError))
    {
        <p class="error" role="alert" data-testid="market-category-interest-error">@Presenter.InterestError</p>
    }
    @if (Presenter.IsRefreshing)
    {
        <p role="status" data-testid="market-categories-refreshing">Refreshing market categories...</p>
    }
    @if (!string.IsNullOrWhiteSpace(Presenter.Error) && Presenter.State is not null)
    {
        <p class="error" role="alert" data-testid="market-categories-stale-failure">The saved categories are still shown. @Presenter.Error</p>
    }
}

@code {
    private bool hasRequiredScope;
    private bool canRefresh;
    private readonly CancellationTokenSource requestLifetime = new();

    protected override async Task OnInitializedAsync()
    {
        hasRequiredScope = await NavigationAccessCoordinator.EnsureRequiredScopesAsync("/market-categories", PlatformAuthenticationDefaults.Scopes.Viewer);
        if (hasRequiredScope)
        {
            canRefresh = (await OperatorContextAccessor.GetCurrentAsync()).IsOperator;
            await Presenter.LoadAsync(requestLifetime.Token);
        }
    }

    private async Task RefreshAsync() => await Presenter.RefreshAsync(requestLifetime.Token);

    private Task SetInterestAsync(MarketCategoryViewModel category, ChangeEventArgs args) =>
        Presenter.SetInterestAsync(category.Code, args.Value is bool interested && interested, requestLifetime.Token);

    public void Dispose()
    {
        requestLifetime.Cancel();
        requestLifetime.Dispose();
    }
}
