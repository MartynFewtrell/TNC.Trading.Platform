@implements IDisposable
@inject PlatformThemeState ThemeState

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="app.css" />
    <RadzenTheme Theme="@ThemeState.RadzenThemeName" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js"></script>
    <script src="platform-theme.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    private CancellationTokenSource? themeInitializationRetryCancellationTokenSource;
    private Task? themeInitializationRetryTask;

    protected override void OnInitialized()
    {
        ThemeState.Changed += HandleThemeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ThemeState.IsInitialized)
        {
            return;
        }

        await ThemeState.EnsureInitializedAsync();

        if (!ThemeState.IsInitialized)
        {
            ScheduleThemeInitializationRetry();
        }
    }

    public void Dispose()
    {
        themeInitializationRetryCancellationTokenSource?.Cancel();
        themeInitializationRetryCancellationTokenSource?.Dispose();
        ThemeState.Changed -= HandleThemeChanged;
    }

    private void HandleThemeChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void ScheduleThemeInitializationRetry()
    {
        if (themeInitializationRetryTask is { IsCompleted: false })
        {
            return;
        }

        themeInitializationRetryCancellationTokenSource ??= new CancellationTokenSource();
        themeInitializationRetryTask = RetryThemeInitializationAsync(themeInitializationRetryCancellationTokenSource.Token);
    }

    private async Task RetryThemeInitializationAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(100), cancellationToken);

            if (!cancellationToken.IsCancellationRequested)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }
}
