@baseUrl = http://localhost:5055/api/platform
@viewerToken = replace-with-delegated-viewer-access-token
@operatorToken = replace-with-delegated-operator-access-token
@categoryCode = FX
@epic = CS.D.ADAUSD.CFD.IP
@interestRevision = 0
@listingVersion = 1
@instrumentCursor = replace-with-nextCursor-from-first-page

### Read the saved category catalogue, interest, and latest collection states (Viewer)
GET {{baseUrl}}/market-categories
Authorization: Bearer {{viewerToken}}

### Read the first saved instrument page (Viewer; SQL snapshot only)
GET {{baseUrl}}/market-categories/{{categoryCode}}/instruments?pageSize=50
Authorization: Bearer {{viewerToken}}

### Continue browsing the same versioned snapshot (Viewer; use nextCursor from the prior response)
GET {{baseUrl}}/market-categories/{{categoryCode}}/instruments?pageSize=50&cursor={{instrumentCursor}}
Authorization: Bearer {{viewerToken}}

### Read saved detail and independent category coverage (Viewer; SQL only)
GET {{baseUrl}}/market-categories/{{categoryCode}}/instruments/{{epic}}/market-details?listingVersion={{listingVersion}}
Authorization: Bearer {{viewerToken}}

### Read saved detail without a listing-version precondition (Viewer; direct link)
GET {{baseUrl}}/market-categories/{{categoryCode}}/instruments/{{epic}}/market-details
Authorization: Bearer {{viewerToken}}

### Invalid page-size validation example (Viewer)
GET {{baseUrl}}/market-categories/{{categoryCode}}/instruments?pageSize=0
Authorization: Bearer {{viewerToken}}

### Update shared category interest with the latest interestRevision (Operator)
PUT {{baseUrl}}/market-categories/{{categoryCode}}/interest
Authorization: Bearer {{operatorToken}}
Content-Type: application/json

{
  "interested": true,
  "expectedRevision": {{interestRevision}}
}

### Manually refresh the category catalogue during the active schedule (Operator; otherwise returns 409)
POST {{baseUrl}}/market-categories/refresh
Authorization: Bearer {{operatorToken}}

### Read persisted collection status and the safe failure state (Viewer)
GET {{baseUrl}}/instrument-collection/status
Authorization: Bearer {{viewerToken}}
